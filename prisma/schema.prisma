datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANDAL_ADMIN
  PRESIDENT
  TREASURER
  SECRETARY
  COLLECTOR
  VOLUNTEER
  VIEWER
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum Language {
  mr
  hi
  en
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  name             String
  phone            String?
  image            String?
  passwordHash     String?
  preferredLang    Language        @default(mr)
  isSuperAdmin     Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  memberships      MandalMember[]
  createdIncomes   Income[]        @relation("IncomeCollector")
  createdExpenses  Expense[]       @relation("ExpenseCreator")
  approvals        Approval[]
  auditLogs        AuditLog[]
  assignedAreas    AreaCollector[]
  reconciliations  Reconciliation[]

  @@index([email])
}

model Mandal {
  id              String            @id @default(uuid())
  name            String
  shortName       String
  joinCode        String            @unique // 6-digit deterministic join code
  address         String
  city            String
  district        String
  state           String            @default("Maharashtra")
  pincode         String
  contactNumber   String
  email           String?
  logoUrl         String?
  defaultCurrency String            @default("INR")
  defaultLang     Language          @default(mr)
  isSuspended     Boolean           @default(false)
  freeIncomeLimit Decimal           @default(50000.00) @db.Decimal(12, 2)
  approvalLimit   Decimal           @default(5000.00) @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members         MandalMember[]
  festivals       Festival[]
  incomeHeads     IncomeCategory[]
  expenseHeads    ExpenseCategory[]
  accounts        Account[]
  donors          Donor[]
  receiptTemplate ReceiptTemplate?
  receiptCounter  ReceiptCounter?
  areas           Area[]
  auditLogs       AuditLog[]
  joinRequests    JoinRequest[]
  notifications   Notification[]
  transactions    Transaction[]

  @@index([joinCode])
}

model MandalMember {
  id         String    @id @default(uuid())
  mandalId   String
  userId     String
  role       Role      @default(VOLUNTEER)
  isActive   Boolean   @default(true)
  joinedAt   DateTime  @default(now())

  mandal     Mandal    @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mandalId, userId])
  @@index([mandalId, role])
}

model JoinRequest {
  id         String         @id @default(uuid())
  mandalId   String
  userId     String
  status     ApprovalStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())

  mandal     Mandal         @relation(fields: [mandalId], references: [id], onDelete: Cascade)

  @@unique([mandalId, userId])
}

model Festival {
  id            String         @id @default(uuid())
  mandalId      String
  name          String         // e.g. Ganeshotsav 2026
  financialYear String         // 2026-2027
  startDate     DateTime
  endDate       DateTime
  budget        Decimal        @default(0.00) @db.Decimal(12, 2)
  isActive      Boolean        @default(true)
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  mandal        Mandal         @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  incomes       Income[]
  expenses      Expense[]
  receipts      Receipt[]

  @@index([mandalId, isActive])
}

model Account {
  id             String          @id @default(uuid())
  mandalId       String
  name           String          // Cash in Hand, Main Bank A/c, Primary UPI
  type           PaymentMethod   // CASH, BANK, UPI, OTHER
  accountNumber  String?
  ifscCode       String?
  openingBalance Decimal         @default(0.00) @db.Decimal(12, 2)
  currentBalance Decimal         @default(0.00) @db.Decimal(12, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  mandal         Mandal          @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
  reconciliations Reconciliation[]

  @@index([mandalId, type])
}

model IncomeCategory {
  id          String    @id @default(uuid())
  mandalId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  mandal      Mandal    @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  incomes     Income[]

  @@index([mandalId])
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  mandalId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  mandal      Mandal    @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@index([mandalId])
}

model Donor {
  id             String    @id @default(uuid())
  mandalId       String
  name           String
  phone          String?
  address        String?
  area           String?
  totalDonated   Decimal   @default(0.00) @db.Decimal(12, 2)
  donationCount  Int       @default(0)
  lastDonationAt DateTime?
  createdAt      DateTime  @default(now())

  mandal         Mandal    @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  incomes        Income[]

  @@index([mandalId, phone])
  @@index([mandalId, name])
}

model Transaction {
  id             String          @id @default(uuid())
  mandalId       String
  festivalId     String
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  date           DateTime        @default(now())
  isArchived     Boolean         @default(false)
  archiveReason  String?
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  mandal         Mandal          @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  festival       Festival        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  income         Income?
  expense        Expense?
  transfer       AccountTransfer?
  ledgerEntries  LedgerEntry[]

  @@index([mandalId, festivalId, date])
  @@index([mandalId, isArchived])
}

model Income {
  id             String          @id @default(uuid())
  transactionId  String          @unique
  festivalId     String
  categoryId     String
  donorId        String?
  donorName      String
  donorPhone     String?
  amount         Decimal         @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  collectorId    String
  notes          String?
  isAnonymous    Boolean         @default(false)
  createdAt      DateTime        @default(now())

  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  festival       Festival        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  category       IncomeCategory  @relation(fields: [categoryId], references: [id])
  donor          Donor?          @relation(fields: [donorId], references: [id], onDelete: SetNull)
  collector      User            @relation("IncomeCollector", fields: [collectorId], references: [id])
  receipt        Receipt?

  @@index([festivalId, paymentMethod])
  @@index([collectorId])
}

model Expense {
  id             String          @id @default(uuid())
  transactionId  String          @unique
  festivalId     String
  categoryId     String
  payeeName      String
  amount         Decimal         @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  status         ApprovalStatus  @default(PENDING)
  billNumber     String?
  attachmentUrl  String?
  createdById    String
  notes          String?
  createdAt      DateTime        @default(now())

  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  festival       Festival        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy      User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvals      Approval[]

  @@index([festivalId, status])
}

model AccountTransfer {
  id             String        @id @default(uuid())
  transactionId  String        @unique
  fromAccountId  String
  toAccountId    String
  amount         Decimal       @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())

  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id            String        @id @default(uuid())
  transactionId String
  accountId     String
  debit         Decimal       @default(0.00) @db.Decimal(12, 2)
  credit        Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAfter  Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model ReceiptCounter {
  id         String   @id @default(uuid())
  mandalId   String   @unique
  currentVal Int      @default(0)
  updatedAt  DateTime @updatedAt

  mandal     Mandal   @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model Receipt {
  id             String        @id @default(uuid())
  incomeId       String        @unique
  festivalId     String
  receiptNumber  String        @unique
  sequenceNumber Int
  shareToken     String        @unique // Cryptographic random access token
  donorName      String
  amount         Decimal       @db.Decimal(12, 2)
  amountInWords  String
  issuedAt       DateTime      @default(now())

  income         Income        @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  festival       Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([festivalId, sequenceNumber])
  @@index([shareToken])
}

model ReceiptTemplate {
  id           String   @id @default(uuid())
  mandalId     String   @unique
  prefix       String   @default("UH")
  headerText   String?
  footerNote   String?  @default("श्रींच्या चरणी सादर अर्पण. धन्यवाद!")
  signatoryUrl String?
  showQR       Boolean  @default(true)

  mandal       Mandal   @relation(fields: [mandalId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String         @id @default(uuid())
  expenseId  String
  userId     String
  status     ApprovalStatus
  comment    String?
  createdAt  DateTime       @default(now())

  expense    Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Area {
  id          String          @id @default(uuid())
  mandalId    String
  name        String
  description String?

  mandal      Mandal          @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  households  Household[]
  collectors  AreaCollector[]

  @@index([mandalId])
}

model Household {
  id           String   @id @default(uuid())
  areaId       String
  houseNumber  String
  familyName   String
  phone        String?
  targetAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  collected    Decimal  @default(0.00) @db.Decimal(10, 2)
  status       String   @default("PENDING") // PENDING, PARTIAL, COLLECTED
  updatedAt    DateTime @updatedAt

  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId, status])
}

model AreaCollector {
  id      String @id @default(uuid())
  areaId  String
  userId  String

  area    Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([areaId, userId])
}

model Reconciliation {
  id             String   @id @default(uuid())
  accountId      String
  userId         String
  expectedBalance Decimal @db.Decimal(12, 2)
  actualBalance   Decimal @db.Decimal(12, 2)
  difference      Decimal @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())

  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@index([accountId])
}

model Notification {
  id        String   @id @default(uuid())
  mandalId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  mandal    Mandal   @relation(fields: [mandalId], references: [id], onDelete: Cascade)

  @@index([mandalId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  mandalId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  mandal    Mandal   @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mandalId, createdAt])
}
